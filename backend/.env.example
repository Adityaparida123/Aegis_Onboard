# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me

# Persistence
# Leave empty (unset) to run in in-memory mode.
# Point at a running MongoDB to enable mongodb-backed persistence.
MONGODB_URI=

# Uploads
UPLOAD_DIR=./tmp/uploads

# CORS
# Comma-separated origins allowed to call the API.
# Defaults to localhost dev origins when unset.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# AI (optional)
# Set to enable the Gemini skill. Falls back to the rule-based planner when unset.
# Also enables natural-language answers from the EmployeeSupportAgent.
GEMINI_API_KEY=
